# 服务端口
PORT=3000

# JWT密钥（生产环境务必更换为强随机字符串）
JWT_SECRET=ygqjob_jwt_secret_change_in_production_2026

# 数据库路径
DATA_PATH=./data

# 前端静态文件路径（生产模式）
STATIC_PATH=../

# 允许的前端域名（CORS）
ALLOWED_ORIGIN=http://localhost:3000,https://www.ygqjob.cn

# 环境模式
NODE_ENV=development

# ===== AI 语义搜索配置 =====
# LLM API Key（必填，支持 OpenAI / DeepSeek / 通义千问 等兼容接口）
LLM_API_KEY=sk-your-api-key-here
# LLM API 地址（可选，默认为 OpenAI 官方地址）
# 使用 DeepSeek 时改为: https://api.deepseek.com/v1/chat/completions
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# 模型名称（可选，默认 gpt-4o-mini，推荐 deepseek-chat 性价比更高）
# LLM_MODEL=gpt-4o-mini
# 请求超时毫秒（可选，默认 5000）
# LLM_TIMEOUT_MS=5000